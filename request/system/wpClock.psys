namespace request\system;

use system\WebCom;
use system\std;
require_once 'system/Helper/wpClock.psys';
wpClock::$ip = std::posts('ip');
class wpClock {
	public static $ip;
	const c_setColor = 'setColor';
	public static function setColor() {
		header(wpJSON_HEADER);
		$cmd = 'cmd=setColor' . std::posts('section') . '&r=' . std::posts('r') . '&g=' . std::posts('g') . '&b=' . std::posts('b');
		$WebCom = new WebCom();
		echo $WebCom->send('SetD1MiniUrlCmd', wpClock::$ip . '%~%' . 'setClock?' . $cmd);
	}
	const c_simulateTime = 'SimulateTime';
	public static function simulateTime() {
		header(wpJSON_HEADER);
		$hour = std::posts('hour');
		$minute = std::posts('minute');
		$second = std::posts('second');
		$cmd = 'cmd=simulate&h=' . $hour . '&m=' . $minute . '&s=' . $second;
		$WebCom = new WebCom();
		echo $WebCom->send('SetD1MiniUrlCmd', wpClock::$ip . '%~%' . 'setClock?' . $cmd);
	}
	const c_simulationOff = 'SimulateOff';
	public static function simulationOff() {
		header(wpJSON_HEADER);
		$cmd = 'cmd=simulate';
		$WebCom = new WebCom();
		echo $WebCom->send('SetD1MiniUrlCmd', wpClock::$ip . '%~%' . 'setClock?' . $cmd);
	}
}

switch(std::gets('param1')) {
	//###################################################################################
	case wpClock::c_setColor:
		wpClock::setColor();
		break;
	//###################################################################################
	case wpClock::c_simulateTime:
		wpClock::simulateTime();
		break;
	//###################################################################################
	case wpClock::c_simulationOff:
		wpClock::simulationOff();
		break;
}

